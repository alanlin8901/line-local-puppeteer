{
  "name": "line-oa-cloudflare-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "auth:upload": "wrangler kv key put line-auth-state --binding LINE_STATE --path .line-auth-state.json --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "wrangler": "4.131.1"
  }
}
